RUN node --test /opt/aiofcage-postgres/policy.test.mjs && chmod 755 /opt/aiofcage-postgres/server.mjs
{{range .Connectors}}{{if .Package}}RUN npm install --global --no-fund --no-audit --ignore-scripts "{{.Package}}@{{.Version}}" \
    && npm cache clean --force
{{end}}{{end}}COPY connector /usr/local/bin/aiofcage-connector
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/aiofcage-connector"]
CMD ["serve", "--listen", "0.0.0.0:8080", "--launch", "/run/aiofcage/launch.json"]
