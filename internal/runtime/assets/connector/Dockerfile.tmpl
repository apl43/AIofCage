FROM public.ecr.aws/docker/library/node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
COPY postgres-package.json /opt/aiofcage-postgres/package.json
COPY postgres-package-lock.json /opt/aiofcage-postgres/package-lock.json
RUN cd /opt/aiofcage-postgres && npm ci --omit=dev --no-fund --no-audit --ignore-scripts && npm cache clean --force
COPY postgres-policy.mjs /opt/aiofcage-postgres/policy.mjs
COPY postgres-server.mjs /opt/aiofcage-postgres/server.mjs
